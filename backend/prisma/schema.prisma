generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserAccountRole {
  ADMIN
  TEACHER
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ENROLLED
  PENDING
}

enum ClassProgram {
  MED
  ENG
  ICS
  IT
  FA
}

enum GradeLevel {
  GRADE_11
  GRADE_12
}

enum Availability {
  ONSITE
  ONLINE
  BOTH
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum AnnouncementAudience {
  STUDENTS
  TEACHERS
  BOTH
}

enum AnnouncementPriority {
  URGENT
  NORMAL
  INFORMATIONAL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ChallanStatus {
  UNPAID
  PAID
  PARTIAL
  OVERDUE
  ROLLED_OVER
}

enum ExpenseType {
  ADMISSION_FEE
  REGISTRATION_FEE // unused — Admission Fee serves as the registration fee; kept to match applied migration
  MISC_FEE
  BAG
  UNIFORM
  BOOKS
  OTHER
}

enum DocumentType {
  PHOTO
  BFORM
  CNIC_FRONT
  CNIC_BACK
  FATHER_CNIC_FRONT
  FATHER_CNIC_BACK
  MATRIC_RESULT
}

enum ExamType {
  PAST_PAPER
  MIDTERM
  MONTHLY_TEST
  WEEKLY_TEST
  BIMONTHLY_TEST
  FINAL
  QUIZ
  ASSIGNMENT
  TASK
}

enum SalaryStatus {
  GENERATED
  APPROVED
  PAID
}

enum PaymentType {
  FEE
  SALARY
}

enum PaymentMethod {
  CASH
  BANK
  ONLINE
}

enum TeacherTier {
  TIER_1
  TIER_2A
  TIER_2B
  TIER_3
}

// ── Core Auth Models ──────────────────────────────────────────────────────────

model User {
  id                 Int             @id @default(autoincrement())
  email              String?         @unique
  password           String
  role               UserAccountRole
  isVerified         Boolean         @default(false)
  profilePicUrl      String?
  profilePicPublicId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  teacher           Teacher?
  admin             Admin?
  refreshTokens     RefreshToken[]
  emailVerification EmailVerification?
  passwordResets    PasswordReset[]

  // RBAC — a user can hold multiple roles, each role bundles permissions
  roles Role[]

  // Audit trail - tracks who created/graded/generated content
  createdExams             Exam[]              @relation("CreatedByExam")
  gradedMarks              Mark[]              @relation("GradedByMark")
  generatedReports         MonthlyReport[]     @relation("GeneratedByReport")
  createdAnnouncements     Announcement[]      @relation("CreatedByAnnouncement")
  createdChallans          Challan[]           @relation("CreatedByChallan")
  generatedSalaries        Salary[]            @relation("GeneratedBySalary")
  createdExpenses          StudentExpense[]    @relation("CreatedByExpense")
  receivedPayments         PaymentHistory[]    @relation("ReceivedByPayment")
  markedTeacherAttendances TeacherAttendance[] @relation("MarkedTeacherAttendance")
  uploadedDocuments        StudentDocument[]   @relation("UploadedByDocument")
}

// Belongs to exactly one of User (admin/teacher) or Student — never both.
model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int?
  studentId Int?
  family    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([studentId])
  @@index([family])
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Belongs to exactly one of User (admin/teacher) or Student — never both.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int?
  studentId Int?
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([studentId])
}

// ── RBAC — Users hold Roles, Roles bundle Permissions ─────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions Permission[]
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique // e.g. "students.manage"
  description String?
  category    String? // groups permissions in the UI, e.g. "Students"
  createdAt   DateTime @default(now())

  roles Role[]
}

model Admin {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
}

// ── People ────────────────────────────────────────────────────────────────────

model Teacher {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  address       String?
  joiningDate   DateTime @default(now())
  additionalPay Int      @default(0)
  basicSalary   Int      @default(0)
  bonus         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tier TeacherTier @default(TIER_3)

  subjects SubjectTeacher[]

  attendances Attendance[]

  teacherAttendances TeacherAttendance[]

  timetables Timetable[]

  salaries Salary[]

  qualifications TeacherQualification[]
}

model TeacherQualification {
  id                 Int      @id @default(autoincrement())
  teacherId          Int
  teacher            Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  degreeTitle        String
  institute          String
  startYear          Int
  endYear            Int
  totalMarksOrGpa    String
  obtainedMarksOrGpa String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([teacherId])
}

// Students are no longer backed by a User account — they log in with their
// rollNumber + password directly. Email (optional) is only used to send a
// password-reset link; an admin can also reset a student's password directly.
model Student {
  id                 Int           @id @default(autoincrement())
  rollNumber         String        @unique
  password           String
  email              String?       @unique
  profilePicUrl      String?
  profilePicPublicId String?
  // Personal Info
  name               String
  dateOfBirth        DateTime
  gender             Gender
  cnic               String?
  address            String
  phone              String?
  // Guardian Info
  fatherName         String
  guardianPhone      String
  // School Info
  schoolName         String?
  // Fees & Discounts
  registrationFee    Int?
  familyDiscount     Int? // discount applied if sibling is already enrolled
  // Academic Info
  joiningDate        DateTime
  academicYear       String        @default("2025-2026")
  status             StudentStatus @default(ENROLLED)
  registrationDate   DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  enrollment Enrollment?

  subjects StudentSubject[]

  attendances Attendance[]

  challans Challan[]

  marks Mark[]

  reports MonthlyReport[]

  expenses StudentExpense[]

  documents StudentDocument[]

  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
}

// ── Classes ───────────────────────────────────────────────────────────────────
// Classes charge a custom monthly fee per student (set on enrollment).
// Teachers are assigned per subject, not per class.

model Class {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  gradeLevel   GradeLevel   @default(GRADE_11)
  program      ClassProgram @default(ICS)
  studentLimit Int          @default(35)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subjects    Subject[]
  enrollments Enrollment[]
  timetables  Timetable[]
  exams       Exam[]

  // Student attendance is recorded per class. Teacher attendance is no longer
  // tied to a class at all — see TeacherAttendance.
  attendances Attendance[]
}

model Subject {
  id           Int          @id @default(autoincrement())
  name         String
  gradeLevel   GradeLevel   @default(GRADE_11)
  availability Availability @default(ONSITE)
  createdAt    DateTime     @default(now())

  // A subject can now be shared across multiple classes of the same grade level
  classes Class[]

  teacherAssignments SubjectTeacher[]
  studentEnrollments StudentSubject[]
  timetableSlots     Timetable[]
  exams              Exam[]

  @@unique([name, gradeLevel])
}

// A teacher is assigned to a specific subject, not to the whole class
model SubjectTeacher {
  id         Int      @id @default(autoincrement())
  subjectId  Int
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId  Int
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([subjectId, teacherId])
}

// Tracks which subjects a student is enrolled in
model StudentSubject {
  id         Int      @id @default(autoincrement())
  studentId  Int
  subjectId  Int
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, subjectId])
  @@index([studentId])
  @@index([subjectId])
}

// A student can be enrolled in only one class
model Enrollment {
  id         Int      @id @default(autoincrement())
  studentId  Int      @unique
  classId    Int?
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  monthlyFee Int // custom fee agreed for this student
  isActive   Boolean  @default(true)
  enrolledAt DateTime @default(now())

  @@index([classId])
}

model Timetable {
  id        Int       @id @default(autoincrement())
  classId   Int
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId Int
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId Int?
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  room      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([classId, dayOfWeek, startTime])
}

// Attendance is recorded per class (one record per student per class per day),
// not per subject.
model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  classId   Int
  teacherId Int?
  date      DateTime
  status    AttendanceStatus
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@unique([studentId, classId, date])
  @@index([studentId])
  @@index([date])
  @@index([teacherId])
  @@index([classId])
}

model Exam {
  id            Int      @id @default(autoincrement())
  title         String
  examType      ExamType
  classId       Int
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     Int
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  totalMarks    Int
  passingMarks  Int
  scheduledDate DateTime
  createdBy     Int
  createdByUser User     @relation("CreatedByExam", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  marks Mark[]

  @@index([createdBy])
  @@index([scheduledDate])
}

model Mark {
  id            Int      @id @default(autoincrement())
  examId        Int
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     Int
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  obtainedMarks Decimal
  grade         String?
  remarks       String?
  gradedBy      Int
  gradedByUser  User     @relation("GradedByMark", fields: [gradedBy], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([examId, studentId])
  @@index([gradedBy])
}

model MonthlyReport {
  id                   Int      @id @default(autoincrement())
  studentId            Int
  student              Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month                Int
  year                 Int
  attendancePercentage Decimal
  totalPresent         Int
  totalAbsent          Int
  totalLeave           Int      @default(0)
  totalWorkingDays     Int
  averageMarks         Decimal?
  totalExams           Int      @default(0)
  examsPassed          Int      @default(0)
  tasksAssigned        Int      @default(0)
  tasksCompleted       Int      @default(0)
  teacherRemarks       String?
  generatedBy          Int
  generatedByUser      User     @relation("GeneratedByReport", fields: [generatedBy], references: [id], onDelete: Restrict)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([studentId, month, year])
  @@index([generatedBy])
}

// Teacher attendance is marked explicitly (like student attendance) — one
// record per teacher per day, not tied to any specific class.
model TeacherAttendance {
  id           Int              @id @default(autoincrement())
  teacherId    Int?
  date         DateTime
  status       AttendanceStatus @default(PRESENT)
  teacher      Teacher?         @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  markedBy     Int?
  markedByUser User?            @relation("MarkedTeacherAttendance", fields: [markedBy], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@unique([teacherId, date])
  @@index([teacherId])
  @@index([date])
}

// ── Communication ─────────────────────────────────────────────────────────────

model Announcement {
  id            Int                  @id @default(autoincrement())
  title         String
  content       String
  audience      AnnouncementAudience
  priority      AnnouncementPriority @default(NORMAL)
  publishedAt   DateTime             @default(now())
  expiresAt     DateTime?
  isActive      Boolean              @default(true)
  createdBy     Int
  createdByUser User                 @relation("CreatedByAnnouncement", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([createdBy])
}

// ── Fee System (flat monthly fee per class) ────────────────────────────────────

model Challan {
  id                Int           @id @default(autoincrement())
  challanNumber     String        @unique
  studentId         Int
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issueDate         DateTime      @default(now())
  dueDate           DateTime
  month             Int
  year              Int
  monthlyFee        Int
  arrears           Int           @default(0)
  lateFee           Int           @default(0)
  discount          Int           @default(0)
  additionalCharges Int           @default(0)
  totalAmount       Int
  status            ChallanStatus @default(UNPAID)
  paidAmount        Int           @default(0)
  paidDate          DateTime?
  remarks           String?
  createdBy         Int
  createdByUser     User          @relation("CreatedByChallan", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  rolledIntoId      Int?
  rolledIntoChallan Challan?  @relation("RolledInto", fields: [rolledIntoId], references: [id])
  rolledChallans    Challan[] @relation("RolledInto")

  expenses       StudentExpense[]
  paymentHistory PaymentHistory[]

  @@unique([studentId, month, year])
  @@index([createdBy])
  @@index([status])
  @@index([dueDate])
}

// ── Student Expenses (one-time charges included in specific challan) ───────────

model StudentExpense {
  id            Int         @id @default(autoincrement())
  studentId     Int
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type          ExpenseType
  label         String? // custom display label (auto-set from type if blank)
  amount        Int
  month         Int
  year          Int
  challanId     Int?
  challan       Challan?    @relation(fields: [challanId], references: [id], onDelete: SetNull)
  createdBy     Int
  createdByUser User        @relation("CreatedByExpense", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([createdBy])
  @@index([studentId])
}

// ── Student Documents (stored in Google Drive, one folder per student) ─────────

model StudentDocument {
  id             Int          @id @default(autoincrement())
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           DocumentType
  driveFileId    String
  driveFolderId  String
  fileName       String
  mimeType       String
  fileSize       Int
  uploadedBy     Int
  uploadedByUser User         @relation("UploadedByDocument", fields: [uploadedBy], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, type])
  @@index([studentId])
}

// ── Salary Models ─────────────────────────────────────────────────────────────

model Salary {
  id              Int          @id @default(autoincrement())
  teacherId       Int?
  teacher         Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  month           Int
  year            Int
  basicSalary     Int          @default(0)
  additionalPay   Int          @default(0)
  totalSalary     Int          @default(0)
  status          SalaryStatus @default(GENERATED)
  remarks         String?
  generatedBy     Int
  generatedByUser User         @relation("GeneratedBySalary", fields: [generatedBy], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  paymentHistory PaymentHistory[]

  @@unique([teacherId, month, year])
  @@index([generatedBy])
  @@index([status])
}

// ── Payment History ───────────────────────────────────────────────────────────

model PaymentHistory {
  id              Int           @id @default(autoincrement())
  paymentType     PaymentType
  challanId       Int?
  challan         Challan?      @relation(fields: [challanId], references: [id], onDelete: SetNull)
  salaryId        Int?
  salary          Salary?       @relation(fields: [salaryId], references: [id], onDelete: SetNull)
  amount          Int
  paymentMethod   PaymentMethod @default(CASH)
  previousBalance Int           @default(0)
  newBalance      Int           @default(0)
  receivedBy      Int?
  receivedByUser  User?         @relation("ReceivedByPayment", fields: [receivedBy], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([receivedBy])
  @@index([paymentType])
}

// ── Payment Info (configuration) ────────────────────────────────────────────
// Bank/payment account details admins maintain under Configurations →
// Payment Info, shown to payers alongside fee challans.

model PaymentInfo {
  id            Int      @id @default(autoincrement())
  bankName      String
  accountTitle  String
  accountNumber String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
